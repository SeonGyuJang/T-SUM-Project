# ── 스크래퍼 (README 8장) ─────────────────────────────
SCRAPER_HEADLESS=false              # TBD-10: 기본값 사용 (Docker에서는 Xvfb 가상 화면에 표시)
SCRAPER_DELAY_MIN_SEC=3
SCRAPER_DELAY_MAX_SEC=7
SCRAPER_PAGE_LOAD_TIMEOUT_SEC=20
SCRAPER_MAX_PAGES_PER_ANALYSIS=80
SCRAPER_MAX_PAGES_PER_DAY=1500
SCRAPER_BLOCK_COOLDOWN_MIN=60
SCRAPER_PARSER_FAIL_THRESHOLD=0.2
SCRAPER_EMPTY_STREAK_LIMIT=3
SAMPLE_PER_STAR=100
REVIEW_SORT=latest
# coupang(운영) | fixture(개발·테스트, 실제 사이트 접속 안 함)
REVIEW_PROVIDER=coupang
# 작성자 닉네임 해시용 솔트(비밀값). 예: python -c "import secrets;print(secrets.token_hex(16))"
AUTHOR_HASH_SALT=

# 학습용 과거 리뷰 배치 수집 (서비스 수집보다 느리게)
TRAINING_DELAY_MIN_SEC=8
TRAINING_DELAY_MAX_SEC=15
TRAINING_MAX_PAGES_PER_DAY=300
TRAINING_CUTOFF_DATE=2022-11-30

# ── 비전 ──────────────────────────────────────────────
OCR_ENGINE=paddleocr                # paddleocr | easyocr | none
VLM_ENABLED=false                   # TBD-5: 기본값 사용(OCR만)
VLM_MODEL_PATH=

# ── 인프라 ────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://realstar:realstar@localhost:5432/realstar
REDIS_URL=redis://localhost:6379/0
DETECTOR_URL=http://localhost:8001
TASK_BACKEND=celery                 # celery | inline(Redis 없이 단일 프로세스)
CORS_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=realstar

# ── 탐지 / 집계 ───────────────────────────────────────
# http(detector_server 호출) | inprocess(realstar_model 직접 로드) | dummy(개발 전용 가짜 판별기)
DETECTOR_MODE=http
# detector_server: realstar_model | dummy
DETECTOR_BACKEND=realstar_model
MODEL_ARTIFACT_PATH=../model/artifacts/det-ko-review-v1.0
MODEL_VERSION=det-ko-review-v1.0
MIN_CHARS=20
TOP_MIN_CHARS=40
CACHE_TTL_HOURS=24
BOOTSTRAP_ITERATIONS=1000

# ── 상품 식별 (TBD-4: 기본값 사용) ─────────────────────
RESOLVE_AUTO_TOP1=0.85
RESOLVE_AUTO_GAP=0.15

# ── 웹 (docker compose 빌드 인자) ─────────────────────
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000
DEMO_MODE=false

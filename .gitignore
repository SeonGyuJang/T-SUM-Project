# ─────────────────────────────────────────────────────────────
# 크롤링·데이터 수집이 만드는 파일 (git에 올리지 않음)
# ─────────────────────────────────────────────────────────────
# 수집용 Chrome 프로필: 쿠키·로그인 세션·방문 기록·캐시가 들어 있다 (coupang_reviews.py PROFILE_DIR)
.browser_profile/
**/.browser_profile/
# 병렬 수집 작업자별 프로필 사본 (collect_training_data.py --workers)
.browser_profile_w*/
# 서비스용 수집기 결과: output/products/*.json, all_products.json, failed.txt, raw/debug/ (crawler_last.log, search_last.html 포함)
output/
# 이전 수집 시험(spike) 결과 HTML·리포트
var/
# 학습용 데이터 수집기 결과·상태·디버그 화면 (collect_training_data.py → model/data/raw/, model/data/debug/)
model/data/
model/artifacts/
# 혹시 다른 위치에 생긴 수집 결과
coupang_training.json
*.json.tmp
*.jsonl
all_products.json
failed.txt
crawler_last.log
search_last.html
# Playwright·Patchright가 만드는 기록
*.har
trace.zip
traces/

# ─────────────────────────────────────────────────────────────
# 서비스 실행이 만드는 파일
# ─────────────────────────────────────────────────────────────
# DB(SQLite), 상태, 로그
service/var/
*.db
*.sqlite
*.sqlite3
*.log
dump.rdb
# 비밀값
.env
.env.*
!.env.example
!.env.local.example
!service/.env.example
!service/.env.local.example

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
.ipynb_checkpoints/


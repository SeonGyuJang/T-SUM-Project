# ── 내 PC에서 실행하기 (docs/local-run-guide.md) ─────────────────────────────
# Redis·PostgreSQL·Celery 없이 API 하나로 동작한다. AI 모델 대신 개발용 더미 판별기를 쓴다.
# 복사:  macOS/Linux  cp .env.local.example .env      Windows  copy .env.local.example .env

# 실제 쿠팡에서 수집 (화면 없이 시험만 하려면 fixture)
REVIEW_PROVIDER=coupang
# Chrome 창을 띄워 수집 과정을 눈으로 본다(TBD-10 기본값)
SCRAPER_HEADLESS=false
SCRAPER_DELAY_MIN_SEC=3
SCRAPER_DELAY_MAX_SEC=7
# 빠른 확인용으로 별점당 20개만 (정식 값은 100)
SAMPLE_PER_STAR=20

# 단일 프로세스 실행
TASK_BACKEND=inline
REDIS_URL=
# DATABASE_URL을 비우면 service/var/realstar.db(SQLite)를 쓴다

# AI 모델 개발 전: 개발용 더미 판별기 (결과 화면에 '개발용 결과' 경고가 붙는다)
DETECTOR_MODE=dummy

# 이미지 입력(OCR)은 선택: pip install -e ".[ocr]" 후 paddleocr (Python 3.11·3.12만 지원)
OCR_ENGINE=none

CORS_ORIGINS=http://localhost:3000
AUTHOR_HASH_SALT=local-dev-salt

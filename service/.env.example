# ── 수집 ───────────────────────────────────────────────
# 라이브 쿠팡 스크래퍼는 제거됨. 저장된 리뷰 JSON으로 동작하는 fixture만 지원.
REVIEW_PROVIDER=fixture
SAMPLE_PER_STAR=100
REVIEW_SORT=latest
BLOCK_COOLDOWN_MIN=60

# ── 비전 ──────────────────────────────────────────────
OCR_ENGINE=paddleocr                # paddleocr | easyocr | none
VLM_ENABLED=false                   # TBD-5: 기본값 사용(OCR만)
VLM_MODEL_PATH=

# ── 인프라 ────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://realstar:realstar@localhost:5432/realstar
REDIS_URL=redis://localhost:6379/0
DETECTOR_URL=http://localhost:8001
TASK_BACKEND=celery                 # celery | inline(Redis 없이 단일 프로세스)
CORS_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=realstar

# ── 탐지 / 집계 ───────────────────────────────────────
# http(detector_server 호출) | inprocess(realstar_model 직접 로드) | dummy(개발 전용 가짜 판별기)
DETECTOR_MODE=http
# detector_server: realstar_model | dummy
DETECTOR_BACKEND=realstar_model
MODEL_ARTIFACT_PATH=../model/artifacts/det-ko-review-v1.0
MODEL_VERSION=det-ko-review-v1.0
MIN_CHARS=20
TOP_MIN_CHARS=40
CACHE_TTL_HOURS=24
BOOTSTRAP_ITERATIONS=1000

# ── 상품 식별 (TBD-4: 기본값 사용) ─────────────────────
RESOLVE_AUTO_TOP1=0.85
RESOLVE_AUTO_GAP=0.15

# ── 웹 (docker compose 빌드 인자) ─────────────────────
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000
DEMO_MODE=false

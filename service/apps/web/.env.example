# 백엔드 API 주소 (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# live(실제 API) | mock(MSW 목업, 5.7 스키마)
NEXT_PUBLIC_API_MODE=live
# 발표 모드: 저장된 예시 결과만으로 전체 흐름 시연(네트워크·스크래핑 없음, README 14.7)
NEXT_PUBLIC_DEMO_MODE=false
# 배포 주소 (메타태그·sitemap). Heroku: 홈페이지 앱의 https://<앱>-<임의문자>.herokuapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

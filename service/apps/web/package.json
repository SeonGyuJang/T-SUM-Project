{
  "name": "realstar-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:mock": "NEXT_PUBLIC_API_MODE=mock next dev -p 3000",
    "dev:demo": "NEXT_PUBLIC_DEMO_MODE=true next dev -p 3000",
    "build": "next build",
    "build:demo": "NEXT_PUBLIC_DEMO_MODE=true next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:e2e": "playwright test --trace off",
    "screenshots": "node scripts/screenshots.mjs",
    "og": "node scripts/make-og.mjs",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "msw": "2.15.0",
    "postcss": "8.5.32",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

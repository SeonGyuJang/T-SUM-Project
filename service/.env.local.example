# ── 내 PC에서 실행하기 (docs/local-run-guide.md) ─────────────────────────────
# Redis·PostgreSQL·Celery 없이 API 하나로 동작한다.
# 복사:  macOS/Linux  cp .env.local.example .env      Windows  copy .env.local.example .env

# 수집: 요청(링크·상품명·이미지)이 들어오면 저장소 루트의 coupang_reviews.py를 실행한다.
#   fixture 로 바꾸면 저장된 예시 JSON(tests/fixtures/json)만 쓴다.
REVIEW_PROVIDER=crawler
SAMPLE_PER_STAR=100
# 수집기를 다른 가상환경에서 돌린다면 그 파이썬 경로 (비우면 서비스와 같은 파이썬 → scrapling 설치 필요)
CRAWLER_PYTHON=
# 브라우저 창 숨기기 (수집기 안내: 숨기면 차단이 늘 수 있음)
CRAWLER_HEADLESS=false
# 이미 수집을 마친 output/products/<상품ID>.json 이 이 시간 안이면 다시 수집하지 않는다 (0 = 항상 재사용)
CRAWLER_REUSE_HOURS=24
# 쿠팡이 차단(403 등)하면 이 시간(분) 동안 새 수집을 쉰다
BLOCK_COOLDOWN_MIN=30

# 단일 프로세스 실행
TASK_BACKEND=inline
REDIS_URL=
# DATABASE_URL을 비우면 service/var/realstar.db(SQLite)를 쓴다

# AI 판별: 모델 개발 전에는 none (판별만 건너뛰고 수집 결과·별점 분포·리뷰는 홈페이지에 그대로 나온다)
#   dummy = 개발용 가짜 판별기(화면 확인용, 숫자는 의미 없음)
DETECTOR_MODE=none
# AI 판정 기준: AI가 썼을 확률(P)이 DETECT_T_AI 이상이면 AI, DETECT_T_HUMAN 미만이면 사람, 그 사이는 판단 보류(20자 미만도 보류)
# 모델 파일(manifest.json)에 저장된 기준을 쓰려면 DETECT_THRESHOLD_SOURCE=model
DETECT_T_AI=0.90
DETECT_T_HUMAN=0.20
DETECT_THRESHOLD_SOURCE=service

# 이미지 입력(OCR): pip install -e ".[ocr]" 후 paddleocr (Python 3.11·3.12만 지원)
OCR_ENGINE=none

CORS_ORIGINS=http://localhost:3000
